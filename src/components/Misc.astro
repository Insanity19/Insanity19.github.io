---
interface Item {
  category: string;
  content: string[];
}

const items: Item[] = [
  {
    category: 'Currently Reading',
    content: ['《Love in a Fallen City》 Eileen Chang'],
  },
  {
    category: 'Listening To',
    content: ['Jacob Collier - Djesse Vol.4', 'Fox Stevenson - Sunk Cost Fallacy'],
  },
  {
    category: 'Side Project',
    content: ['AI4Science'],
  },
  {
    category: 'Hobby',
    content: ['Electronic Guitar and Bass', 'Bouldering', 'Minecraft'],
  },
  {
    category: 'Fun Fact',
    content: ['A lot of my bouldering friends are twins and so am I'],
  },
  {
    category: 'Currently Learning',
    content: [],
  },
];
---

<section id="misc">
  <div class="container">
    <div class="section-header">
      <h2>Misc</h2>
    </div>

    <ul class="misc-grid">
      {items.map((item, i) => (
        <li class="misc-card">
          <dt class="label misc-cat">{item.category}</dt>
          <dd class="misc-content">
            {item.content.map((line, j) => (
              <>
                {line}
                {j < item.content.length - 1 && <br />}
              </>
            ))}
          </dd>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .misc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .misc-card {
    background: var(--bg);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .misc-card:hover { background: var(--surface); }

  .misc-cat {
    color: var(--accent);
  }

  .misc-content {
    font-family: var(--f-display);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .misc-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 520px) {
    .misc-grid { grid-template-columns: 1fr; }
  }
</style>
