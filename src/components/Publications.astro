---
interface PubLink {
  label: string;
  url: string;
}

interface Publication {
  year: string;
  title: string;
  authors: string[];
  venue: string;
  image?: string;
  tags?: string[];
  links?: PubLink[];
}

const ME = 'Sitong Pan';

const publications: Publication[] = [

  {
    year: '2026',
    title: 'Monitoring Web Agents Without Internal Signals: Observable Trajectories and Key-Step Supervision',
    authors: ['Sitong Pan', 'Yipeng Shen', 'Yilin Lu', 'Caiwen Ding', 'Lu Cheng', 'Qianwen Wang'],
    venue: 'Preprint',
    image: '/pub/agent-monitoring.png',
    tags: ['Web Agents', 'Uncertainty', 'LLM'],
    links: [
      { label: 'Paper', url: 'https://arxiv.org/abs/2609.02057' },
    ],
  },
  {
    year: '2026',
    title: 'Not All Uncertainty Is Equal: How Uncertainty Granularity Shapes Human Verification in LLM-Assisted Decision Making',
    authors: ['Mauricio Villavicencio', 'Sitong Pan', 'Qianwen Wang'],
    venue: 'ACM FAccT 2026',
    image: '/pub/facct26.png',
    tags: ['Human-AI Collaboration', 'Uncertainty', 'LLM'],
    links: [
      { label: 'Paper', url: 'https://arxiv.org/abs/2605.28571' },
    ],
  },
  {
    year: '2026',
    title: 'TrajectoryCurer: Visual Analysis of Trajectory Data Quality',
    authors: ['Xiaodan Miao', 'Sitong Pan', 'Shifu Chen', 'Di Weng', 'Yingcai Wu'],
    venue: 'IEEE PacificVis 2026',
    image: '/pub/trajectorycurer.png',
    tags: ['Visualization', 'Trajectory'],
    links: [
      { label: 'Paper', url: 'https://dwe.ng/pdf/trajcurer.pdf' },
    ],
  },
  {
    year: '2025',
    title: 'TutorUp: What if your students were simulated? Training tutors to address engagement challenges in online learning',
    authors: ['Sitong Pan', 'Robin Schmucker', 'Bernardo Garcia Bulle Bueno', 'Salome Aguilar Llanes', 'Fernanda Albo Alarcón', 'Hangxiao Zhu', 'Adam Teo', 'Meng Xia'],
    venue: 'ACM CHI 2025',
    image: '/pub/tutorup.png',
    tags: ['HCI', 'Education', 'LLM'],
    links: [
      { label: 'Paper', url: 'https://dl.acm.org/doi/pdf/10.1145/3706598.3713589' },
    ],
  },
  {
    year: '2025',
    title: 'ReSpark: Leveraging Previous Data Reports as References to Generate New Reports with LLMs',
    authors: ['Yuan Tian', 'Chuhan Zhang', 'Xiaotong Wang', 'Sitong Pan', 'Weiwei Cui', 'Haidong Zhang', 'Dazhen Deng', 'Yingcai Wu'],
    venue: 'ACM UIST 2025',
    image: '/pub/respark.png',
    tags: ['LLM', 'Data Visualization'],
    links: [
      { label: 'Paper', url: 'https://dl.acm.org/doi/pdf/10.1145/3746059.3747644' },
      { label: 'Code', url: 'https://github.com/ZJUIDG-AIVA/ReSpark' },
    ],
  },
];
---

<section id="publications">
  <div class="container">
    <div class="section-header">
      <h2>Publications</h2>
    </div>

    <ul class="pub-list">
      {publications.map((p, i) => (
        <li class="pub-item">
          <div class="pub-thumb">
            {p.image
              ? <img src={p.image} alt={p.title} />
              : <div class="pub-thumb-placeholder" />
            }
          </div>
          <div class="pub-body">
            <span class="label pub-year">{p.year} {p.venue}</span>
            <p class="pub-title">{p.title}</p>
            <p class="pub-authors">
              {p.authors.map((a, j) => (
                <>
                  {a === ME ? <strong class="pub-me">{a}</strong> : a}
                  {j < p.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
            {p.links && p.links.length > 0 && (
              <div class="pub-links">
                {p.links.map((l, k) => (
                  <>
                    {k > 0 && <span class="pub-link-sep">/</span>}
                    <a href={l.url} class="pub-link-btn" target="_blank" rel="noopener">{l.label}</a>
                  </>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* 紧接在 Hero 的 News 之后，顶部留白比其他 section 收窄 */
  #publications { padding-block-start: clamp(1.25rem, 2vw, 1.75rem); }

  .pub-list {
    display: flex;
    flex-direction: column;
  }

  .pub-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.5rem;
    padding-block: 0.85rem;
    align-items: start;
  }

  .pub-thumb {
    width: 240px;
    height: 160px;
    flex-shrink: 0;
  }

  .pub-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }

  .pub-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--surface);
    border-radius: 2px;
  }

  .pub-year {
    color: var(--forest);
    font-weight: 600;
    display: inline-block;
    background: var(--forest-bg);
    border: 1px solid var(--forest);
    border-radius: 999px;
    /* 右内边距略小，抵消 letter-spacing 在末字符后多出的空隙 */
    padding: 0.16rem 0.5rem 0.16rem 0.65rem;
    margin-bottom: 0.4rem;
  }

  .pub-title {
    font-family: var(--f-display);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.15rem;
    color: var(--gold);
  }

  .pub-authors {
    font-family: var(--f-display);
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.4;
    margin-bottom: 0.7rem;
  }

  .pub-me {
    color: var(--fg);
    font-weight: 600;
  }

  .pub-links {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .pub-link-sep {
    font-family: var(--f-label);
    font-size: 0.8rem;
    color: var(--forest);
  }

  .pub-link-btn {
    font-family: var(--f-label);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--forest);
  }

  .pub-link-btn:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .pub-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pub-thumb { width: 100%; height: 180px; }
  }
</style>
